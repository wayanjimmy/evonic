#!/usr/bin/env bash
# Evonic CLI — wrapper script.
# Checks for .venv or venv in the project root before falling back to system python3.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- detect virtualenv python ---
# Windows virtual environments place the interpreter at Scripts/python.exe,
# while POSIX virtual environments use bin/python. Probe the Windows layout
# first so a native Windows venv is used from Git Bash / MSYS shells, then fall
# back to the POSIX layout. Skipping the Windows candidates makes the launcher
# silently pick an unrelated system interpreter, which then fails with a
# misleading "No module named 'flask'" error even though the project venv has
# every dependency installed.
PYTHON=""

# Windows layout — accept via -f so the interpreter is not rejected on
# filesystems that do not expose the POSIX executable bit (.exe runs regardless).
for candidate in \
    "$SCRIPT_DIR/.venv/Scripts/python.exe" \
    "$SCRIPT_DIR/venv/Scripts/python.exe"
do
    if [ -f "$candidate" ]; then
        PYTHON="$candidate"
        break
    fi
done

# POSIX layout — require the executable bit.
if [ -z "$PYTHON" ]; then
    for candidate in "$SCRIPT_DIR/.venv/bin/python" "$SCRIPT_DIR/venv/bin/python"; do
        if [ -x "$candidate" ]; then
            PYTHON="$candidate"
            break
        fi
    done
fi

if [ -z "$PYTHON" ]; then
    # Fallback: let the system find an interpreter on PATH (python3, then python
    # for Windows shells that expose only the latter).
    PYTHON="$(command -v python3 || command -v python || true)"
fi

if [ -z "$PYTHON" ]; then
    {
        echo "evonic: no Python interpreter found."
        echo "  Checked project virtual environments:"
        echo "    $SCRIPT_DIR/.venv/Scripts/python.exe (Windows)"
        echo "    $SCRIPT_DIR/venv/Scripts/python.exe (Windows)"
        echo "    $SCRIPT_DIR/.venv/bin/python (Linux/macOS)"
        echo "    $SCRIPT_DIR/venv/bin/python (Linux/macOS)"
        echo "  and no python3/python was found on PATH."
        echo "  Create a virtual environment first, e.g.:"
        echo "    python -m venv .venv"
        echo "  then install dependencies and re-run ./evonic."
    } >&2
    exit 1
fi

export EVONIC_SCRIPT_DIR="$SCRIPT_DIR"
exec "$PYTHON" -c "
import sys, os
_script_dir = os.environ['EVONIC_SCRIPT_DIR']
sys.path.insert(0, _script_dir)
from cli.__main__ import main
main()
" "$@"